{
  "name": "@groupher/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./auth": "./src/auth.ts",
    "./headers": "./src/headers.ts",
    "./health": "./src/health.ts"
  },
  "scripts": {
    "type-check": "pnpm exec tsc --noEmit --project ./tsconfig.json",
    "lint": "pnpm exec oxlint src --threads=1",
    "test": "pnpm exec vitest --config vitest.config.mts run",
    "format": "pnpm exec oxfmt -c ../../frontend/core/config/oxfmt.json src *.json *.md *.mts",
    "format:check": "pnpm exec oxfmt -c ../../frontend/core/config/oxfmt.json --check src *.json *.md *.mts",
    "build": "echo 'skip build'"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^4.1.5"
  }
}
