{
  "name": "@groupher/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./auth": "./src/auth.ts",
    "./auth-cookie": "./src/auth-cookie.ts",
    "./auth-generated": "./src/auth.generated.ts",
    "./article-stats": "./src/article-stats.ts",
    "./content-publish": "./src/content-publish.ts",
    "./gate": "./src/gate.ts",
    "./public-cache": "./src/public-cache.ts",
    "./view-counting": "./src/view-counting.ts",
    "./endpoint": "./src/endpoint.ts",
    "./headers": "./src/headers.ts",
    "./health": "./src/health.ts",
    "./fixtures/wallpaper-settings-v1.json": "./fixtures/wallpaper-settings-v1.json",
    "./fixtures/wallpaper-profile-matrix-v1.json": "./fixtures/wallpaper-profile-matrix-v1.json",
    "./fixtures/pagination-default-v1.json": "./fixtures/pagination-default-v1.json",
    "./pagination": "./src/pagination.ts",
    "./review-ai": "./src/review-ai.generated.ts",
    "./wallpaper": "./src/wallpaper.ts",
    "./widget": "./src/widget.ts"
  },
  "scripts": {
    "type-check": "pnpm exec tsc --noEmit --project ./tsconfig.json",
    "generate:auth": "node scripts/generate-auth-contract.mjs",
    "generate:auth:check": "node scripts/generate-auth-contract.mjs --check",
    "generate:content-publish": "node scripts/generate-content-publish-contract.mjs",
    "generate:content-publish:check": "node scripts/generate-content-publish-contract.mjs --check",
    "generate:gate": "node scripts/generate-gate-contract.mjs",
    "generate:gate:check": "node scripts/generate-gate-contract.mjs --check",
    "generate:view-counting": "node scripts/generate-view-counting-contract.mjs",
    "generate:view-counting:check": "node scripts/generate-view-counting-contract.mjs --check",
    "generate:review-ai": "node scripts/generate-review-ai-contract.mjs",
    "generate:review-ai:check": "node scripts/generate-review-ai-contract.mjs --check",
    "lint": "pnpm exec oxlint src --threads=1",
    "test": "node scripts/generate-auth-contract.mjs --check && node scripts/generate-content-publish-contract.mjs --check && node scripts/generate-gate-contract.mjs --check && node scripts/generate-view-counting-contract.mjs --check && node scripts/generate-review-ai-contract.mjs --check && pnpm exec vitest --config vitest.config.mts run",
    "format": "pnpm exec oxfmt -c ../../frontend/core/config/oxfmt.json src *.json *.md *.mts",
    "format:check": "pnpm exec oxfmt -c ../../frontend/core/config/oxfmt.json --check src *.json *.md *.mts",
    "build": "echo 'skip build'"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "vitest": "^5.0.4"
  }
}
