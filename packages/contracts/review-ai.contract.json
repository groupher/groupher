{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groupher.dev/contracts/review-ai-v1.json",
  "title": "Review AI HTTP contract",
  "type": "object",
  "definitions": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "systemPrompt",
        "prompt",
        "banWords",
        "text",
        "images",
        "requiredModalities"
      ],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "systemPrompt": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string" },
        "banWords": {
          "type": "array",
          "items": { "type": "string", "maxLength": 128 },
          "maxItems": 10000
        },
        "text": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "body"],
          "properties": { "title": { "type": "string" }, "body": { "type": "string" } }
        },
        "images": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "assetId": { "type": ["string", "null"] },
              "immutableVersion": { "type": ["string", "null"] },
              "signedReadUrl": { "type": ["string", "null"], "format": "uri" }
            }
          }
        },
        "requiredModalities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["text", "image"] }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "susNotes", "coverage", "summary"],
      "properties": {
        "status": { "enum": ["clear", "suspect", "uncertain"] },
        "susNotes": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "evidence", "explanation"],
            "properties": {
              "type": {
                "enum": ["spam", "harassment", "illegal_content", "impersonation", "other"]
              },
              "evidence": { "type": "string", "maxLength": 500 },
              "explanation": { "type": "string", "maxLength": 1000 }
            }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "image"],
          "properties": {
            "text": { "enum": ["complete", "unsupported", "failed"] },
            "image": { "enum": ["complete", "unsupported", "failed"] }
          }
        },
        "summary": { "type": "string", "maxLength": 2000 }
      }
    }
  }
}
