{
  "name": "@groupher/artiment-publisher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "type-check": "pnpm exec tsc --noEmit --project ./tsconfig.json",
    "test": "pnpm exec vitest --config vitest.config.mts run",
    "lint": "pnpm exec oxlint . --threads=1",
    "format": "pnpm exec oxfmt -c ../../frontend/core/config/oxfmt.json *.ts *.json *.md *.mts",
    "format:check": "pnpm exec oxfmt -c ../../frontend/core/config/oxfmt.json --check *.ts *.json *.md *.mts",
    "build": "echo 'skip build'"
  },
  "dependencies": {
    "@groupher/rich-editor": "0.0.35",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/sanitize-html": "^2.16.1",
    "vitest": "^4.1.10"
  }
}
