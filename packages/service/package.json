{
  "name": "@groupher/service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./auth": "./auth/index.ts",
    "./health": "./health/index.ts",
    "./http": "./http/index.ts"
  },
  "scripts": {
    "type-check": "../../node_modules/.bin/tsc --noEmit --project ./tsconfig.json",
    "lint": "../../node_modules/.bin/oxlint auth health http --threads=1",
    "format": "../../node_modules/.bin/oxfmt -c ../../frontend/core/config/oxfmt.json auth health http *.json *.md",
    "format:check": "../../node_modules/.bin/oxfmt -c ../../frontend/core/config/oxfmt.json --check auth health http *.json *.md",
    "build": "echo 'skip build'"
  },
  "dependencies": {
    "@groupher/contracts": "1.0.0",
    "jose": "^6.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
