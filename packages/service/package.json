{
  "name": "@groupher/service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./health": "./src/health.ts",
    "./http": "./src/http.ts"
  },
  "scripts": {
    "type-check": "../../node_modules/.bin/tsc --noEmit --project ./tsconfig.json",
    "lint": "../../node_modules/.bin/oxlint src --threads=1",
    "format": "../../node_modules/.bin/oxfmt -c ../../frontend/core/config/oxfmt.json src *.json *.md",
    "format:check": "../../node_modules/.bin/oxfmt -c ../../frontend/core/config/oxfmt.json --check src *.json *.md",
    "build": "echo 'skip build'"
  },
  "dependencies": {
    "@groupher/contracts": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "lint-staged": {
    "**/*.ts": "tsc-files --noEmit --project ./tsconfig.json"
  }
}
