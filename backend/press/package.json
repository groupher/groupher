{
  "name": "@groupher/press",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "cf dev --mode development",
    "test": "pnpm exec vitest --config vitest.config.mts run",
    "type-check": "pnpm run types && pnpm exec tsc --noEmit --project ./tsconfig.json",
    "build": "cf build --mode production",
    "build:node": "rimraf dist && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "deploy": "cf deploy --mode production",
    "types": "cf workers types --mode production",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "lint": "pnpm exec oxlint src --threads=1",
    "format": "pnpm exec oxfmt -c ../../frontend/core/config/oxfmt.json src *.ts *.json *.mts",
    "format:check": "pnpm exec oxfmt -c ../../frontend/core/config/oxfmt.json --check src *.ts *.json *.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@groupher/contracts": "workspace:*",
    "@groupher/service": "workspace:*",
    "@hono/node-server": "^2.1.8",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "isbot": "^5.2.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
    "@cloudflare/workers-types": "^5.20261115.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "cf": "1.0.0-beta.21",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.1",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
