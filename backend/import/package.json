{
  "name": "@groupher/import",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf dev --mode development --port 8001",
    "test": "pnpm exec vitest --config vitest.config.mts run",
    "test:worker": "node ./scripts/worker-smoke.mjs",
    "type-check": "pnpm exec tsc --noEmit --project ./tsconfig.json",
    "type-check:workers": "pnpm exec tsc --noEmit --project ./workers/tsconfig.json",
    "deploy": "cf deploy --mode production",
    "deploy:dry-run": "cf deploy --dry-run --mode production",
    "lint": "pnpm exec oxlint src --threads=1",
    "format": "pnpm exec oxfmt -c ../../frontend/core/config/oxfmt.json src index.ts *.json *.mts *.ts",
    "format:check": "pnpm exec oxfmt -c ../../frontend/core/config/oxfmt.json --check src index.ts *.json *.mts *.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@babel/parser": "8.0.4",
    "@groupher/content-publisher": "workspace:*",
    "@groupher/contracts": "workspace:*",
    "@groupher/rich-editor": "0.0.35",
    "@groupher/route-contract": "workspace:*",
    "@groupher/service": "workspace:*",
    "files-sdk": "3.1.1",
    "hono": "^4.13.13",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-mdx": "3.0.0",
    "mdast-util-to-string": "4.0.0",
    "micromark-extension-mdxjs": "3.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tar-stream": "3.2.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261013.1",
    "@types/node": "^26.6.5",
    "@types/tar-stream": "^3.1.5",
    "cf": "1.0.0-beta.13",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4",
    "wrangler": "4.149.0"
  }
}
