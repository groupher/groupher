{
  "name": "@groupher/assets-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:upload-api",
    "dev:local": "tsx scripts/dev-local.ts",
    "dev:upload-api": "tsx watch src/server.ts",
    "dev:read-worker": "cf dev --mode development",
    "dev:worker": "pnpm run dev:read-worker",
    "deploy:worker": "cf deploy --mode production",
    "deploy:worker:dry-run": "cf deploy --dry-run --mode production",
    "smoke:r2": "tsx scripts/r2-smoke.ts",
    "test:unit": "pnpm exec vitest --config vitest.config.mts run",
    "test:worker": "pnpm exec vitest --config vitest.worker.config.mts run",
    "type-check": "pnpm exec tsc --noEmit --project ./tsconfig.json",
    "build": "rimraf dist && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "lint": "pnpm exec oxlint src scripts index.ts --threads=1",
    "format": "pnpm exec oxfmt -c ../../frontend/core/config/oxfmt.json src scripts index.ts *.json",
    "format:check": "pnpm exec oxfmt -c ../../frontend/core/config/oxfmt.json --check src scripts index.ts *.json",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@groupher/contracts": "workspace:*",
    "@groupher/service": "workspace:*",
    "@hono/node-server": "^2.0.11",
    "dotenv": "^17.4.2",
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
    "@cloudflare/vitest-plugin": "^1.3.1",
    "@cloudflare/workers-types": "^5.20260929.1",
    "@types/node": "^24.0.0",
    "cf": "1.0.0-beta.5",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
