{
  "name": "@groupher/backend-assets-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "smoke:r2": "tsx scripts/r2-smoke.ts",
    "type-check": "../../node_modules/.bin/tsc --noEmit --project ./tsconfig.json",
    "build": "rimraf dist && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "lint": "../../node_modules/.bin/oxlint src scripts index.ts --threads=1",
    "format": "../../node_modules/.bin/oxfmt -c ../../frontend/core/config/oxfmt.json src scripts index.ts *.json",
    "format:check": "../../node_modules/.bin/oxfmt -c ../../frontend/core/config/oxfmt.json --check src scripts index.ts *.json",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@groupher/contracts": "1.0.0",
    "@groupher/service": "1.0.0",
    "@hono/node-server": "^2.0.11",
    "dotenv": "^17.4.2",
    "hono": "^4.12.31"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1"
  },
  "lint-staged": {
    "**/*.ts": "tsc-files --noEmit --project ./tsconfig.json"
  }
}
