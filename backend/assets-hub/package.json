{
  "name": "@groupher/assets-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir ../.. devhub start assets-hub",
    "dev:local": "pnpm --dir ../.. devhub start assets-hub",
    "dev:local:managed": "tsx watch src/server.ts",
    "dev:cloudflare": "pnpm --dir ../.. devhub start assets-read-worker",
    "dev:upload-api": "pnpm --dir ../.. devhub start assets-hub",
    "dev:upload-api:managed": "tsx watch src/server.ts",
    "dev:read-worker": "pnpm --dir ../.. devhub start assets-read-worker",
    "dev:worker": "pnpm --dir ../.. devhub start assets-read-worker",
    "dev:read-worker:managed": "cf dev --mode development -- --host 127.0.0.1 --port 8787",
    "deploy:worker": "cf deploy --mode production",
    "deploy:worker:dry-run": "cf deploy --dry-run --mode production",
    "smoke:r2": "tsx scripts/r2-smoke.ts",
    "test:unit": "pnpm exec vitest --config vitest.config.mts run",
    "test:worker": "pnpm exec vitest --config vitest.worker.config.mts run",
    "type-check": "pnpm exec tsc --noEmit --project ./tsconfig.json",
    "build": "rimraf dist && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "lint": "pnpm exec oxlint src scripts index.ts --threads=1",
    "format": "pnpm exec oxfmt -c ../../frontend/core/config/oxfmt.json src scripts index.ts *.json",
    "format:check": "pnpm exec oxfmt -c ../../frontend/core/config/oxfmt.json --check src scripts index.ts *.json",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@aws-sdk/s3-request-presigner": "^3.1176.0",
    "@groupher/contracts": "workspace:*",
    "@groupher/service": "workspace:*",
    "@hono/node-server": "^2.1.11",
    "dotenv": "^18.0.10",
    "hono": "^4.13.21"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.4",
    "@cloudflare/vitest-plugin": "^1.9.1",
    "@cloudflare/workers-types": "^5.20261123.1",
    "@types/node": "^26.6.6",
    "cf": "1.0.0-rc.4",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
