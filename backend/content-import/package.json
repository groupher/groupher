{
  "name": "@groupher/backend-content-import",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test": "../../node_modules/.bin/vitest --config vitest.config.mts run",
    "type-check": "../../node_modules/.bin/tsc --noEmit --project ./tsconfig.json",
    "build": "rimraf dist && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "lint": "../../node_modules/.bin/oxlint src --threads=1",
    "format": "../../node_modules/.bin/oxfmt -c ../../frontend/core/config/oxfmt.json src index.ts *.json *.mts",
    "format:check": "../../node_modules/.bin/oxfmt -c ../../frontend/core/config/oxfmt.json --check src index.ts *.json *.mts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@babel/parser": "7.29.0",
    "@groupher/contracts": "1.0.0",
    "@groupher/rich-editor": "0.0.35",
    "@groupher/service": "1.0.0",
    "@hono/node-server": "^2.0.11",
    "dotenv": "^17.4.2",
    "files-sdk": "2.2.0",
    "hono": "^4.12.31",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-mdx": "3.0.0",
    "mdast-util-to-string": "4.0.0",
    "micromark-extension-mdxjs": "3.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sanitize-html": "^2.17.3",
    "tar-stream": "3.2.0",
    "undici": "^7.25.0",
    "workflow": "4.6.0",
    "yaml": "2.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/sanitize-html": "^2.16.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "**/*.ts": "tsc-files --noEmit --project ./tsconfig.json"
  }
}
