{
  "name": "@groupher/backend-content-import",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test": "pnpm exec vitest --config vitest.config.mts run",
    "type-check": "pnpm exec tsc --noEmit --project ./tsconfig.json",
    "build": "rimraf dist && esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "lint": "pnpm exec oxlint src --threads=1",
    "format": "pnpm exec oxfmt -c ../../frontend/core/config/oxfmt.json src index.ts *.json *.mts",
    "format:check": "pnpm exec oxfmt -c ../../frontend/core/config/oxfmt.json --check src index.ts *.json *.mts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@babel/parser": "8.0.4",
    "@groupher/artiment-publisher": "workspace:*",
    "@groupher/contracts": "workspace:*",
    "@groupher/rich-editor": "0.0.35",
    "@groupher/service": "workspace:*",
    "@hono/node-server": "^2.0.11",
    "@vercel/blob": "2.6.1",
    "dotenv": "^17.4.2",
    "files-sdk": "2.2.3",
    "hono": "^4.13.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-mdx": "3.0.0",
    "mdast-util-to-string": "4.0.0",
    "micromark-extension-mdxjs": "3.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tar-stream": "3.2.0",
    "undici": "^8.10.0",
    "workflow": "4.8.0",
    "yaml": "2.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/tar-stream": "^3",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.5",
    "vitest": "^4.1.10"
  }
}
