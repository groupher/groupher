{
  "name": "@groupher/inspire-me",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "generate:data": "node scripts/generate-feedback-data.mjs",
    "dev": "yarn generate:data && vinext dev",
    "type-check": "yarn generate:data && ../../node_modules/.bin/tsc --noEmit --project ./tsconfig.json",
    "build": "yarn generate:data && vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "../../node_modules/.bin/oxlint app --threads=1",
    "format": "../../node_modules/.bin/oxfmt -c ./oxfmt.json ./app",
    "format:check": "../../node_modules/.bin/oxfmt -c ./oxfmt.json --check ./app",
    "clean:up": "rm -rf *.tsbuildinfo",
    "deploy": "yarn build && vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@groupher/frontend-core": "1.0.0",
    "@vinext/cloudflare": "^1.0.0-beta.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.0.0-beta.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@tailwindcss/postcss": "4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-rsc": "^0.5.32",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.25",
    "tailwindcss": "4.3.3",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0"
  },
  "lint-staged": {
    "**/*.ts?(x)": "tsc-files --noEmit --project ./tsconfig.json"
  },
  "type": "module"
}
