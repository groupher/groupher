{
  "name": "@groupher/converter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf dev --mode development",
    "deploy": "cf deploy --mode production",
    "deploy:dry-run": "cf deploy --dry-run --mode production",
    "type-check": "pnpm exec tsc --noEmit --project ./tsconfig.json",
    "test:worker": "pnpm exec vitest --config vitest.worker.config.mts run",
    "test:worker:smoke": "node ./scripts/worker-smoke.mjs"
  },
  "dependencies": {
    "@firecrawl/anydoc-wasm": "0.2.4",
    "@mjackson/multipart-parser": "0.10.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261013.1",
    "@types/node": "^26.6.5",
    "cf": "1.0.0-beta.13",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
