{
  "name": "@groupher/frontend-community",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "yarn sync:assets:community && yarn build:revision-worker && vite --config app.config.ts --host 127.0.0.1",
    "build:revision-worker": "yarn --cwd ../.. exec vite build --config frontend/community/vite.worker.config.mts",
    "build": "yarn sync:assets:community && yarn build:revision-worker && CLOUDFLARE_ENV=production vite build --config app.config.ts",
    "preview": "vite preview --config app.config.ts",
    "deploy": "VITE_GIT_COMMIT_SHA=$(git rev-parse --short HEAD) yarn build && wrangler deploy --config dist/server/wrangler.json",
    "deploy:dry-run": "VITE_GIT_COMMIT_SHA=$(git rev-parse --short HEAD) yarn build && wrangler deploy --dry-run --config dist/server/wrangler.json",
    "generate:routes": "node ./scripts/generate-route-tree.mjs",
    "baseline": "node ../../scripts/measure-community-baseline.mjs",
    "check:contract": "yarn generate:routes && node ../../scripts/check-community-contract.mjs",
    "type-check": "yarn generate:routes && ../../node_modules/.bin/tsc --noEmit --project ./tsconfig.json",
    "lint": "../../node_modules/.bin/oxlint src --threads=1",
    "format": "../../node_modules/.bin/oxfmt -c ../core/config/oxfmt.json --ignore-path ./config/oxfmtignore ./src",
    "format:check": "../../node_modules/.bin/oxfmt -c ../core/config/oxfmt.json --ignore-path ./config/oxfmtignore --check ./src",
    "clean": "rimraf .output .tanstack vite.config.*.timestamp-* routeTree.gen.ts src/routeTree.gen.ts *.tsbuildinfo"
  },
  "dependencies": {
    "@groupher/contracts": "1.0.0",
    "@groupher/frontend-core": "1.0.0",
    "@tanstack/query-core": "5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "1.170.21",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.38",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-generator": "1.167.24",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "rimraf": "^6.1.3",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0"
  }
}
