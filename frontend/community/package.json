{
  "name": "@groupher/frontend-community",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir ../.. run sync:assets:community && pnpm run build:revision-worker && vite --config app.config.ts --host 127.0.0.1",
    "build:revision-worker": "pnpm --dir ../.. exec vite build --config frontend/community/vite.worker.config.mts",
    "build": "pnpm --dir ../.. run sync:assets:community && pnpm run build:revision-worker && CLOUDFLARE_ENV=production vite build --config app.config.ts",
    "preview": "vite preview --config app.config.ts",
    "deploy": "VITE_GIT_COMMIT_SHA=$(git rev-parse --short HEAD) cf deploy",
    "deploy:dry-run": "VITE_GIT_COMMIT_SHA=$(git rev-parse --short HEAD) cf deploy --dry-run",
    "generate:routes": "node ./scripts/generate-route-tree.mjs",
    "baseline": "node ../../scripts/measure-community-baseline.mjs",
    "check:contract": "pnpm run generate:routes && node ../../scripts/check-community-contract.mjs",
    "type-check": "pnpm run generate:routes && pnpm exec tsc --noEmit --project ./tsconfig.json",
    "lint": "pnpm exec oxlint src --threads=1",
    "format": "pnpm exec oxfmt -c ../core/config/oxfmt.json --ignore-path ./config/oxfmtignore ./src",
    "format:check": "pnpm exec oxfmt -c ../core/config/oxfmt.json --ignore-path ./config/oxfmtignore --check ./src",
    "clean": "rimraf .output .tanstack vite.config.*.timestamp-* routeTree.gen.ts src/routeTree.gen.ts *.tsbuildinfo"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "3.2.0",
    "@groupher/contracts": "workspace:*",
    "@groupher/frontend-core": "workspace:*",
    "@groupher/route-contract": "workspace:*",
    "@tanstack/query-core": "5.104.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "1.170.40",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.59",
    "graphql": "^17.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-generator": "1.167.39",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cf": "1.0.0-beta.5",
    "rimraf": "^6.1.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
