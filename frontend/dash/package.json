{
  "name": "@groupher/frontend-dash",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:revision-worker": "node ../../scripts/build-dash-revision-worker.mjs",
    "dev": "pnpm --dir ../.. run sync:assets:dash && pnpm run build:revision-worker && vite --config app.config.ts --host 127.0.0.1",
    "build": "pnpm --dir ../.. run sync:assets:dash && pnpm run build:revision-worker && CLOUDFLARE_ENV=production vite build --config app.config.ts",
    "preview": "vite preview --config app.config.ts",
    "deploy": "VITE_GIT_COMMIT_SHA=$(git rev-parse --short HEAD) pnpm run build && cf deploy --prebuilt --mode production",
    "deploy:dry-run": "VITE_GIT_COMMIT_SHA=$(git rev-parse --short HEAD) pnpm run build && cf deploy --prebuilt --dry-run --mode production",
    "cf-typegen": "cf workers types --mode production",
    "generate:routes": "node ./scripts/generate-route-tree.mjs",
    "type-check": "pnpm run generate:routes && pnpm exec tsc --noEmit --project ./tsconfig.json",
    "lint": "pnpm exec oxlint src --threads=1",
    "format": "pnpm exec oxfmt -c ../core/config/oxfmt.json --ignore-path ./config/oxfmtignore ./src",
    "format:check": "pnpm exec oxfmt -c ../core/config/oxfmt.json --ignore-path ./config/oxfmtignore --check ./src",
    "clean": "rimraf .output .tanstack vite.config.*.timestamp-* routeTree.gen.ts src/routeTree.gen.ts *.tsbuildinfo"
  },
  "dependencies": {
    "@graphql-typed-document-node/core": "3.2.0",
    "@groupher/content-publisher": "workspace:*",
    "@groupher/contracts": "workspace:*",
    "@groupher/frontend-core": "workspace:*",
    "@groupher/service": "workspace:*",
    "@tanstack/query-core": "5.104.2",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.1",
    "graphql": "^17.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "valtio": "2.3.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/redact": "0.2.3",
    "@tanstack/router-generator": "1.167.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "1.0.0-beta.13",
    "rimraf": "^6.1.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
