{
  "name": "@groupher/frontend-auth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test": "../../node_modules/.bin/vitest --root ../.. --config frontend/core/vitest.config.mts run frontend/auth",
    "type-check": "../../node_modules/.bin/tsc --noEmit --project ./tsconfig.json",
    "build": "rimraf dist && esbuild src/server.ts --bundle --platform=node --format=esm --external:@auth/core --external:'@auth/core/*' --external:@hono/node-server --external:dotenv --external:hono --external:'hono/*' --outfile=dist/server.js",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "lint": "../../node_modules/.bin/oxlint . --threads=1",
    "format": "../../node_modules/.bin/oxfmt -c ../core/config/oxfmt.json src *.ts *.json",
    "format:check": "../../node_modules/.bin/oxfmt -c ../core/config/oxfmt.json --check src *.ts *.json",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@auth/core": "0.41.0",
    "@groupher/frontend-core": "1.0.0",
    "@hono/node-server": "^2.0.11",
    "dotenv": "^17.4.2",
    "hono": "^4.12.31"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1"
  },
  "lint-staged": {
    "**/*.ts?(x)": "tsc-files --noEmit --project ./tsconfig.json"
  }
}
