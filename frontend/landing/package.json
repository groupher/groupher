{
  "name": "@groupher/frontend-landing",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir ../.. run sync:assets:landing && vite --config app.config.ts --host 127.0.0.1",
    "build": "pnpm --dir ../.. run sync:assets:landing && vite build --config app.config.ts && node ./scripts/finalize-static-build.mjs",
    "preview": "vite preview --config app.config.ts",
    "deploy:worker": "VITE_GIT_COMMIT_SHA=$(git rev-parse --short HEAD) pnpm run build && pnpm exec wrangler deploy --config wrangler.jsonc",
    "deploy:worker:dry-run": "VITE_GIT_COMMIT_SHA=$(git rev-parse --short HEAD) pnpm run build && pnpm exec wrangler deploy --dry-run --config wrangler.jsonc",
    "generate:routes": "node ./scripts/generate-route-tree.mjs",
    "type-check": "pnpm run generate:routes && pnpm exec tsc --noEmit --project ./tsconfig.json",
    "lint": "pnpm exec oxlint src --threads=1",
    "format": "pnpm exec oxfmt -c ../core/config/oxfmt.json --ignore-path ./config/oxfmtignore ./src",
    "format:check": "pnpm exec oxfmt -c ../core/config/oxfmt.json --ignore-path ./config/oxfmtignore --check ./src",
    "clean": "rimraf --glob .output .tanstack dist out routeTree.gen.ts src/routeTree.gen.ts 'vite.config.*.timestamp-*' '*.tsbuildinfo'"
  },
  "dependencies": {
    "@groupher/frontend-core": "workspace:*",
    "@tanstack/react-router": "1.170.21",
    "@tanstack/react-start": "1.168.38",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-generator": "1.167.24",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "rimraf": "^6.1.3",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0"
  }
}
