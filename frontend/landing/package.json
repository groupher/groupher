{
  "name": "@groupher/frontend-landing",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir ../.. run sync:assets:landing && vite --config app.config.ts --host 127.0.0.1",
    "build": "pnpm --dir ../.. run sync:assets:landing && vite build --config app.config.ts && node ./scripts/finalize-static-build.mjs",
    "preview": "vite preview --config app.config.ts",
    "deploy:worker": "VITE_GIT_COMMIT_SHA=$(git rev-parse --short HEAD) pnpm run build && cf deploy --prebuilt",
    "deploy:worker:dry-run": "VITE_GIT_COMMIT_SHA=$(git rev-parse --short HEAD) pnpm run build && cf deploy --prebuilt --dry-run",
    "generate:routes": "node ./scripts/generate-route-tree.mjs",
    "type-check": "pnpm run generate:routes && pnpm exec tsc --noEmit --project ./tsconfig.json",
    "lint": "pnpm exec oxlint src --threads=1",
    "format": "pnpm exec oxfmt -c ../core/config/oxfmt.json --ignore-path ./config/oxfmtignore ./src",
    "format:check": "pnpm exec oxfmt -c ../core/config/oxfmt.json --ignore-path ./config/oxfmtignore --check ./src",
    "clean": "rimraf --glob .cloudflare .output .tanstack dist out routeTree.gen.ts src/routeTree.gen.ts 'vite.config.*.timestamp-*' '*.tsbuildinfo'"
  },
  "dependencies": {
    "@groupher/frontend-core": "workspace:*",
    "@tanstack/react-router": "1.170.40",
    "@tanstack/react-start": "1.168.59",
    "motion": "^12.43.0",
    "ramda": "^0.32.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-scroll-snap-anime-slider": "^1.5.3",
    "react-trend": "^1.2.4",
    "typewriter-effect": "^2.19.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-generator": "1.167.39",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cf": "1.0.0-beta.13",
    "rimraf": "^6.1.3",
    "vite": "^8.3.1"
  }
}
