{
  "name": "@groupher/inspire-me",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:data": "node scripts/generate-feedback-data.mjs",
    "dev": "pnpm run generate:data && vite --config app.config.ts --host 127.0.0.1",
    "type-check": "pnpm run generate:data && pnpm run generate:routes && pnpm exec tsc --noEmit --project ./tsconfig.json",
    "build": "pnpm run generate:data && pnpm run generate:routes && vite build --config app.config.ts",
    "start": "cf dev",
    "generate:routes": "node ./scripts/generate-route-tree.mjs",
    "lint": "pnpm exec oxlint src --threads=1",
    "format": "pnpm exec oxfmt -c ./oxfmt.json ./src",
    "format:check": "pnpm exec oxfmt -c ./oxfmt.json --check ./src",
    "clean": "rimraf --glob .output .tanstack dist 'vite.config.*.timestamp-*' '*.tsbuildinfo'",
    "deploy": "VITE_GIT_COMMIT_SHA=$(git rev-parse --short HEAD) pnpm run build && cf deploy --prebuilt --mode production",
    "deploy:dry-run": "VITE_GIT_COMMIT_SHA=$(git rev-parse --short HEAD) pnpm run build && cf deploy --prebuilt --dry-run --mode production"
  },
  "dependencies": {
    "@groupher/frontend-core": "workspace:*",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "1.170.40",
    "@tanstack/react-start": "1.168.59",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-generator": "1.167.39",
    "@types/node": "24.13.3",
    "@vitejs/plugin-react": "^6.1.1",
    "cf": "1.0.0-beta.13",
    "rimraf": "^6.1.3",
    "tailwindcss": "4.3.3",
    "vite": "^8.3.1"
  }
}
