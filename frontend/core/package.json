    "@groupher/rich-editor": "0.0.36",
    "@groupher/route-contract": "workspace:*",
    "@groupher/service": "workspace:*",
    "@groupher/tooltip": "4.2.7",
    "@groupher/use-mobile-detect-hook": "^2.0.2",
    "@internationalized/date": "3.12.4",
    "@platejs/core": "^53.5.2",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.28",
    "@tanstack/table-core": "9.3.1",
    "@vgpu/wgsl": "0.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "copy-to-clipboard": "4.0.2",
    "emoji-picker-react": "^5.1.4",
    "graphql": "^17.1.0",
    "markdown-to-jsx": "^9.11.0",
    "motion": "^14.14.0",
    "nanoid": "^6.0.2",
    "overlayscrollbars": "^2.17.1",
    "overlayscrollbars-react": "^0.5.8",
    "pinyin-pro": "^3.29.5",
