{
  "name": "@groupher/frontend-core",
  "version": "1.0.0",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    "./tsconfig": "./tsconfig.app.json",
    "./jsconfig": "./jsconfig.json",
    "./tailwind.config": "./tailwind.config.js",
    "./vgpu-vite": {
      "types": "./config/vgpuVitePlugin.d.mts",
      "import": "./config/vgpuVitePlugin.mjs"
    },
    "./oxfmt": "./config/oxfmt.json",
    "./oxlint": "./config/oxlint.json",
    "./dev-hub-reporter": "./lib/devHubReporter/index.ts",
    "./dev-hub-reporter/react": "./ui/DevHubReporter/index.tsx",
    "./graphql/authoring": "./lib/graphql/authoring.ts",
    "./graphql/generated": "./lib/graphql/generated/graphql.ts",
    "./graphql/server-operations": "./lib/graphql/server-operations.ts",
    "./server/content-publisher": "./lib/server/content-publisher.ts"
  },
  "scripts": {
    "graphql:codegen": "cd ../.. && pnpm run graphql:codegen:generate",
    "type-check": "pnpm exec tsc --noEmit --project ./tsconfig.app.json",
    "lint": "pnpm exec oxlint . --threads=1",
    "format": "pnpm exec oxfmt -c ./config/oxfmt.json .",
    "format:check": "pnpm exec oxfmt -c ./config/oxfmt.json --check .",
    "poc:vgpu:build": "vite build --config ./render/BgRenderer/vgpu-poc/vite.config.mts",
    "poc:vgpu:dev": "pnpm --dir ../.. devhub start core-vgpu-poc",
    "poc:vgpu:dev:managed": "vite --config ./render/BgRenderer/vgpu-poc/vite.config.mts --host 127.0.0.1 --port 3012 --strictPort",
    "build": "echo 'skip build'"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
