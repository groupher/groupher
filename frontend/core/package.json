{
  "name": "@groupher/frontend-core",
  "version": "1.0.0",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    "./tsconfig": "./tsconfig.app.json",
    "./jsconfig": "./jsconfig.json",
    "./tailwind.config": "./tailwind.config.js",
    "./postcss.config": "./postcss.config.js",
    "./oxfmt": "./config/oxfmt.json",
    "./oxlint": "./config/oxlint.json",
    "./dev-hub-reporter": "./lib/devHubReporter/index.ts",
    "./dev-hub-reporter/react": "./ui/DevHubReporter/index.tsx"
  },
  "scripts": {
    "type-check": "pnpm exec tsc --noEmit --project ./tsconfig.app.json",
    "lint": "pnpm exec oxlint . --threads=1",
    "format": "pnpm exec oxfmt -c ./config/oxfmt.json .",
    "format:check": "pnpm exec oxfmt -c ./config/oxfmt.json --check .",
    "build": "echo 'skip build'"
  },
  "dependencies": {
    "@groupher/contracts": "workspace:*",
    "cobe": "^2.0.1"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "1.170.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "1.170.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
