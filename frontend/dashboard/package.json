{
  "name": "@groupher/frontend-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "yarn build:revision-worker && next dev --turbo",
    "build:revision-worker": "yarn --cwd ../.. exec vite build --config frontend/dashboard/vite.worker.config.mts",
    "type-check": "next typegen && ../../node_modules/.bin/tsc --noEmit --project ./tsconfig.json",
    "build": "yarn build:revision-worker && cross-env NODE_ENV=production next build --turbopack",
    "start": "cross-env NODe_ENV=production next start -p 3000",
    "dist": "next build && next export -o \"build\"",
    "info": "next info",
    "clean": "shjs ./utils/scripts/clean.js",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "../../node_modules/.bin/oxlint src --threads=1",
    "format": "../../node_modules/.bin/oxfmt -c ../core/config/oxfmt.json ./src",
    "format:check": "../../node_modules/.bin/oxfmt -c ../core/config/oxfmt.json --check ./src",
    "clean:up": "rm -rf *.tsbuildinfo"
  },
  "dependencies": {
    "@babel/parser": "8.0.4",
    "@groupher/artiment-publisher": "1.0.0",
    "@groupher/contracts": "1.0.0",
    "@groupher/frontend-core": "1.0.0",
    "@groupher/service": "1.0.0",
    "@vercel/blob": "2.6.1",
    "files-sdk": "2.2.3",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-mdx": "3.0.0",
    "mdast-util-to-string": "4.0.0",
    "micromark-extension-mdxjs": "3.0.0",
    "next": "16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tar-stream": "3.2.0",
    "undici": "^8.10.0",
    "workflow": "4.8.0",
    "yaml": "2.8.2"
  },
  "devDependencies": {
    "@types/tar-stream": "^3",
    "cross-env": "^10.1.0"
  },
  "lint-staged": {
    "**/*.ts?(x)": "tsc-files --noEmit --project ./tsconfig.json"
  }
}
