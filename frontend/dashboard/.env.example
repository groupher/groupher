# Public app defaults
NEXT_PUBLIC_SITE_URL=https://groupher.localhost
AUTH_URL=https://groupher.localhost
NEXT_PUBLIC_AUTH_ENDPOINT=https://groupher.localhost/api/auth
GRAPHQL_ENDPOINT=http://127.0.0.1:4001/graphiql
AUTH_COOKIE_DOMAIN=.groupher.localhost
AUTH_COOKIE_SECURE=true
NEXT_PUBLIC_ASSETS_ENDPOINT=https://static.groupher.com
NEXT_PUBLIC_ICON=https://static.groupher.com/icons/static
NEXT_PUBLIC_ICON_BASE=https://static.groupher.com/icons

# Built-in Web Analysis identity. Dashboard reads analytics through Phoenix,
# but keeps the same website id for deployment parity and diagnostics.

# Private service endpoints
CONTENT_IMPORT_APP_ENDPOINT=http://127.0.0.1:8001
DOCUMENT_CONVERTER_APP_ENDPOINT=http://127.0.0.1:8000

# Docs bulk-import preview storage. Local development and CI use the filesystem.
# Set this to blob and provide BLOB_READ_WRITE_TOKEN in Vercel Preview/Production.
DOCS_IMPORT_PREVIEW_STORE=local
DOCS_IMPORT_PREVIEW_DIR=.tmp/docs-import/previews
BLOB_READ_WRITE_TOKEN=

# Shared session verification and server trust
PHX_JWT_SECRET=
SERVICE_AUTH_TOKEN_ENDPOINT=http://127.0.0.1:3004/oauth2/token
SERVICE_AUTH_CLIENT_ID=dashboard-development
SERVICE_AUTH_CLIENT_SECRET=
SERVICE_AUTH_ISSUER=http://127.0.0.1:3004
SERVICE_AUTH_JWKS_URL=http://127.0.0.1:3004/.well-known/jwks.json
NEXTAUTH_SECRET=
