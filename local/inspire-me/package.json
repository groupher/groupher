{
  "name": "@groupher/local-inspire-me",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "generate:data": "node scripts/generate-feedback-data.mjs",
    "dev": "yarn generate:data && next dev --turbo",
    "type-check": "yarn generate:data && next typegen && ../../node_modules/.bin/tsc --noEmit --project ./tsconfig.json",
    "build": "yarn generate:data && cross-env NODE_ENV=production next build --webpack",
    "start": "cross-env NODE_ENV=production next start -p 3000",
    "info": "next info",
    "lint": "../../node_modules/.bin/oxlint app --threads=1",
    "format": "../../node_modules/.bin/oxfmt -c ./oxfmt.json ./app",
    "format:check": "../../node_modules/.bin/oxfmt -c ./oxfmt.json --check ./app",
    "clean:up": "rm -rf *.tsbuildinfo",
    "dev:vinext": "yarn generate:data && vinext dev --port 3001",
    "build:vinext": "yarn generate:data && vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "yarn build:vinext && vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@groupher/frontend-core": "1.0.0",
    "@vinext/cloudflare": "^1.0.0-beta.4",
    "next": "16.3.0-preview.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.0.0-beta.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@tailwindcss/postcss": "4.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitejs/plugin-rsc": "^0.5.30",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.10",
    "tailwindcss": "4.3.1",
    "vite": "^8.1.5",
    "wrangler": "^4.114.0"
  },
  "lint-staged": {
    "**/*.ts?(x)": "tsc-files --noEmit --project ./tsconfig.json"
  },
  "type": "module"
}
