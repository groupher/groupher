{
  "$schema": "../../node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "trailingComma": "all",
  "sortImports": true,
  "sortTailwindcss": true,
  "sortPackageJson": true,
  "ignorePatterns": ["dist/**"]
}
