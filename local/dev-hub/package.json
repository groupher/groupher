{
  "name": "@groupher/local-dev-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names api,ui \"DEV_HUB_API_ONLY=true DEV_HUB_PORT=4311 DEV_HUB_WEB_PORT=4310 DEV_HUB_OPEN_BROWSER=false tsx src/server/index.ts\" \"DEV_HUB_API_PORT=4311 vite --host 127.0.0.1 --port 4310 --strictPort --open\"",
    "hub": "vite build && tsx src/server/index.ts",
    "hub:serve": "tsx src/server/index.ts",
    "desktop": "tauri dev",
    "desktop:build": "tauri build --bundles app",
    "desktop:icon": "tauri icon public/favicon.svg",
    "build": "vite build",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "type-check": "tsc --noEmit --project ./tsconfig.json",
    "format": "oxfmt -c ./oxfmt.json ./src ./*.json ./*.ts",
    "format:check": "oxfmt -c ./oxfmt.json --check ./src ./*.json ./*.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hono/node-server": "^2.0.11",
    "@pierre/diffs": "^1.2.12",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elkjs": "^0.12.0",
    "hono": "^4.12.31",
    "lucide-react": "^1.25.0",
    "motion": "^12.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "recharts": "^3.10.0",
    "simple-icons": "16.27.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "oxfmt": "0.47.0",
    "tailwindcss": "4.3.1",
    "tsx": "^4.23.1",
    "typescript": "7.0.2",
    "vite": "^8.0.10"
  }
}
