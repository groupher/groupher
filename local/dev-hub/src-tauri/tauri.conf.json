{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Groupher Dev Hub",
  "version": "0.1.0",
  "identifier": "com.groupher.devhub",
  "build": {
    "frontendDist": "bootstrap"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Groupher Dev Hub",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "visible": true,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "theme": "Light",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 16
        }
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main-window-drag",
          "description": "Allow the local Dev Hub page to provide the native macOS title bar drag region.",
          "windows": ["main"],
          "remote": {
            "urls": [
              "http://127.0.0.1:4310/*",
              "http://127.0.0.1:4311/*",
              "http://127.0.0.1:4312/*",
              "http://127.0.0.1:4313/*",
              "http://127.0.0.1:4314/*",
              "http://127.0.0.1:4315/*",
              "http://127.0.0.1:4316/*",
              "http://127.0.0.1:4317/*",
              "http://127.0.0.1:4318/*",
              "http://127.0.0.1:4319/*",
              "http://127.0.0.1:4320/*",
              "http://127.0.0.1:4321/*",
              "http://127.0.0.1:4322/*",
              "http://127.0.0.1:4323/*",
              "http://127.0.0.1:4324/*",
              "http://127.0.0.1:4325/*",
              "http://127.0.0.1:4326/*",
              "http://127.0.0.1:4327/*",
              "http://127.0.0.1:4328/*",
              "http://127.0.0.1:4329/*",
              "http://127.0.0.1:4330/*",
              "http://127.0.0.1:4331/*",
              "http://127.0.0.1:4332/*",
              "http://127.0.0.1:4333/*",
              "http://127.0.0.1:4334/*",
              "http://127.0.0.1:4335/*",
              "http://127.0.0.1:4336/*",
              "http://127.0.0.1:4337/*",
              "http://127.0.0.1:4338/*",
              "http://127.0.0.1:4339/*"
            ]
          },
          "permissions": [
            "core:window:allow-start-dragging",
            "core:window:allow-internal-toggle-maximize",
            {
              "identifier": "opener:allow-open-url",
              "allow": [
                {
                  "url": "http://localhost:*/*"
                },
                {
                  "url": "http://127.0.0.1:*/*"
                },
                {
                  "url": "https://*.localhost/*"
                },
                {
                  "url": "https://dash.cloudflare.com/*"
                },
                {
                  "url": "https://fly.io/*"
                },
                {
                  "url": "https://dashboard.algolia.com/*"
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
