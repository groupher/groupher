{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Groupher Dev Hub",
  "version": "0.1.0",
  "identifier": "com.groupher.devhub",
  "build": {
    "frontendDist": "bootstrap"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Groupher Dev Hub",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
