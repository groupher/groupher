{
  "name": "@groupher/status",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir ../.. devhub start status",
    "dev:managed": "wrangler dev --local --port \"$PORT\" --env-file \"$DEV_HUB_WORKER_ENV_FILE\" --persist-to \"$DEV_HUB_WORKER_STATE_DIR\"",
    "db:migrate:local": "pnpm --filter @groupher/local-dev-hub exec tsx src/server/status-migrate.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@groupher/contracts": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261123.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "wrangler": "4.167.0"
  }
}
