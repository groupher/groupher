{
  "name": "@groupher/root",
  "version": "1.2.50",
  "private": true,
  "license": "Apache License 2.0",
  "scripts": {
    "generate:icons": "node scripts/generate-fa-regular-icons.mjs",
    "graphql:codegen": "graphql-codegen --config codegen.ts && oxfmt -c frontend/core/config/oxfmt.json frontend/core/lib/graphql/generated",
    "generate:fa-icons": "pnpm run generate:icons",
    "gen:theme-first-paint-vars": "node scripts/generate-theme-first-paint-vars.mjs",
    "check:theme-first-paint-vars": "node scripts/generate-theme-first-paint-vars.mjs --check",
    "check:router-runtime": "node --test scripts/check-router-runtime.test.mjs && node scripts/check-router-runtime.mjs",
    "sync:icons": "node scripts/sync-fa-icons.mjs",
    "sync:icons:dash": "node scripts/sync-fa-icons.mjs dash",
    "sync:icons:landing": "node scripts/sync-fa-icons.mjs landing",
    "sync:icons:community": "node scripts/sync-fa-icons.mjs community",
    "sync:wallpaper": "node scripts/sync-wallpaper-assets.mjs",
    "sync:wallpaper:dash": "node scripts/sync-wallpaper-assets.mjs dash",
    "sync:wallpaper:landing": "node scripts/sync-wallpaper-assets.mjs landing",
    "sync:wallpaper:community": "node scripts/sync-wallpaper-assets.mjs community",
    "sync:assets:dash": "pnpm run sync:icons:dash && pnpm run sync:wallpaper:dash",
    "sync:assets:landing": "pnpm run sync:icons:landing && pnpm run sync:wallpaper:landing",
    "sync:assets:community": "pnpm run sync:icons:community && pnpm run sync:wallpaper:community",
    "sync:fa-icons": "pnpm run sync:icons",
    "sync:fa-icons:landing": "pnpm run sync:icons:landing",
    "clean:dash": "pnpm --filter @groupher/frontend-dash run clean",
    "clean:community": "pnpm --filter @groupher/frontend-community run clean",
    "clean:apply": "pnpm --filter @groupher/frontend-apply run clean",
    "clean:widget": "pnpm --filter @groupher/widget exec rimraf dist",
    "clean:dev-gateway": "pnpm --filter @groupher/dev-gateway run clean",
    "clean:press": "pnpm --filter @groupher/press run clean",
    "clean:auth": "pnpm --filter @groupher/backend-auth run clean",
    "clean:assets-hub": "pnpm --filter @groupher/assets-hub run clean",
    "clean:landing": "pnpm --filter @groupher/frontend-landing run clean",
    "clean:inspire-me": "pnpm --filter @groupher/inspire-me exec rimraf dist *.tsbuildinfo",
    "predev:dash": "pnpm run clean:dash",
    "dev:dash": "pnpm --filter @groupher/frontend-dash run dev",
    "dev:community": "pnpm --filter @groupher/frontend-community run dev",
    "dev:apply": "pnpm --filter @groupher/frontend-apply run dev",
    "dev:widget": "pnpm --filter @groupher/widget run dev",
    "dev:dev-gateway": "pnpm --filter @groupher/dev-gateway run dev",
    "dev:press": "pnpm --filter @groupher/press run dev",
    "dev:auth": "pnpm --filter @groupher/backend-auth run dev",
    "dev:assets-hub": "pnpm --filter @groupher/assets-hub run dev:local",
    "dev:content-import": "pnpm --filter @groupher/backend-content-import run dev",
    "dev:document-converter": "cd backend/document-converter && .venv/bin/python -m uvicorn app:app --reload --port 8000",
    "document-converter:install": "cd backend/document-converter && python3.12 -m venv .venv && .venv/bin/python -m pip install --upgrade pip && .venv/bin/python -m pip install -e '.[test]'",
    "test:document-converter": "cd backend/document-converter && .venv/bin/python -m pytest",
    "auth:env:bootstrap": "node scripts/bootstrap-auth-env.mjs",
    "smoke:auth:v1": "bash scripts/smoke-auth-v1.sh",
    "portless:setup": "portless proxy start && portless trust && pnpm run portless:sync",
    "portless:sync": "portless alias groupher 3003 --force && portless alias dash.groupher 3005 --force && portless alias community.groupher 3007 --force && portless alias apply.groupher 3006 --force && portless alias landing.groupher 3003 --force && portless alias auth.groupher 3004 --force && portless alias inspire-me.groupher 3010 --force && portless alias api.groupher 4001 --force && portless alias content-import.groupher 8001 --force && portless alias assets-hub.groupher 8002 --force && portless alias press.groupher 8003 --force && portless alias assets.groupher 8787 --force && portless alias converter.groupher 8000 --force",
    "build:prod:dash": "pnpm --filter @groupher/frontend-dash run build",
    "build:prod:community": "pnpm --filter @groupher/frontend-community run build",
    "build:prod:apply": "pnpm --filter @groupher/frontend-apply run build",
    "build:prod:widget": "pnpm --filter @groupher/widget run build",
    "predev:landing": "pnpm run clean:landing",
    "dev:landing": "pnpm run clean:landing && pnpm --filter @groupher/frontend-landing run dev",
    "predev:inspire-me": "pnpm run clean:inspire-me",
    "dev:inspire-me": "pnpm run clean:inspire-me && pnpm --filter @groupher/inspire-me run dev --port 3010",
    "build:prod:landing": "pnpm --filter @groupher/frontend-landing run build",
    "prebuild:prod:inspire-me": "pnpm run clean:inspire-me",
    "build:prod:inspire-me": "pnpm run clean:inspire-me && pnpm --filter @groupher/inspire-me run build",
    "serve:prod:landing": "pnpm --filter @groupher/frontend-landing run preview",
    "prebuild:prod:dev-gateway": "pnpm run clean:dev-gateway",
    "build:prod:dev-gateway": "pnpm --filter @groupher/dev-gateway run build",
    "build:prod:press": "pnpm --filter @groupher/press run build",
    "build:prod:auth": "pnpm --filter @groupher/backend-auth run build",
    "build:prod:assets-hub": "pnpm --filter @groupher/assets-hub run build",
    "build:prod:content-import": "pnpm --filter @groupher/backend-content-import run build",
    "serve:prod:dev-gateway": "pnpm --filter @groupher/dev-gateway run start",
    "update.version": "node -p \"'export const APP_VERSION = ' + JSON.stringify(require('./package.json').version)\" > config/version.ts",
    "type-check": "pnpm run check:theme-first-paint-vars && pnpm --filter @groupher/contracts run type-check && pnpm --filter @groupher/route-contract run type-check && pnpm --filter @groupher/service run type-check && pnpm --filter @groupher/artiment-publisher run type-check && pnpm --filter @groupher/frontend-core run type-check && pnpm --filter @groupher/frontend-community run type-check && pnpm --filter @groupher/frontend-dash run type-check && pnpm --filter @groupher/frontend-apply run type-check && pnpm --filter @groupher/widget run type-check && pnpm --filter @groupher/frontend-landing run type-check && pnpm --filter @groupher/inspire-me run type-check && pnpm --filter @groupher/dev-gateway run type-check && pnpm --filter @groupher/edge-router run type-check && pnpm --filter @groupher/backend-auth run type-check && pnpm --filter @groupher/assets-hub run type-check && pnpm --filter @groupher/backend-content-import run type-check && pnpm --filter @groupher/press run type-check && pnpm --filter @groupher/local-dev-hub run type-check",
    "docs:check": "node scripts/check-documentation.mjs",
    "contract:health": "node contracts/services/health/scripts/assert-health.mjs && vitest --config frontend/core/vitest.config.mts run frontend/community/src/server/health.test.ts",
    "contract:graphql": "node contracts/graphql/scripts/assert-graphql-contract.mjs && node contracts/graphql/scripts/assert-static-graphql.mjs && node contracts/graphql/scripts/assert-no-urql.mjs",
    "contract:graphql:generated": "node contracts/graphql/scripts/assert-generated-graphql.mjs",
    "build": "pnpm --recursive --filter '!@groupher/root' --if-present run build",
    "build:clean": "run-s dist clean",
    "build:ci": "pnpm --recursive --filter '!@groupher/root' --if-present run build",
    "clean": "rimraf --glob \"*.tsbuildinfo\" \"frontend/**/*.tsbuildinfo\" \"backend/**/*.tsbuildinfo\"",
    "lint": "pnpm --recursive --filter '!@groupher/root' --if-present run lint",
    "format": "pnpm --recursive --filter '!@groupher/root' --if-present run format",
    "format:check": "pnpm --recursive --filter '!@groupher/root' --if-present run format:check",
    "clean:up": "rm -rf *.tsbuildinfo",
    "test": "vitest --config frontend/core/vitest.config.mts run",
    "test:core": "vitest --config frontend/core/vitest.config.mts run frontend/core",
    "test:landing": "vitest --config frontend/core/vitest.config.mts run frontend/core frontend/landing",
    "mock:server": "pnpm --filter @groupher/mock-server run dev",
    "test:e2e:dash": "cross-env E2E_APP=dash playwright test -c frontend/e2e/playwright.config.ts",
    "test:e2e:landing": "cross-env E2E_APP=landing playwright test -c frontend/e2e/playwright.config.ts",
    "test:e2e:auth": "cross-env E2E_APP=auth playwright test -c frontend/e2e/playwright.config.ts",
    "coveralls": "cat ./coverage/lcov.info | coveralls",
    "doctor": "react-doctor .",
    "doctor:dash": "react-doctor frontend/dash",
    "doctor:landing": "react-doctor frontend/landing",
    "doctor:core": "react-doctor frontend/core",
    "doctor:community": "react-doctor frontend/community",
    "doctor:apply": "react-doctor frontend/apply",
    "doctor:inspire-me": "react-doctor frontend/inspire-me"
  },
