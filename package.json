{
  "name": "@groupher/root",
  "version": "1.2.50",
  "private": true,
  "license": "Apache License 2.0",
  "workspaces": {
    "packages": [
      "backend/*",
      "frontend/*",
      "local/*",
      "packages/*"
    ]
  },
  "scripts": {
    "generate:icons": "node scripts/generate-fa-regular-icons.mjs",
    "generate:fa-icons": "yarn generate:icons",
    "gen:theme-first-paint-vars": "node scripts/generate-theme-first-paint-vars.mjs",
    "check:theme-first-paint-vars": "node scripts/generate-theme-first-paint-vars.mjs --check",
    "sync:icons": "node scripts/sync-fa-icons.mjs",
    "sync:icons:main": "node scripts/sync-fa-icons.mjs main",
    "sync:icons:dashboard": "node scripts/sync-fa-icons.mjs dashboard",
    "sync:icons:landing": "node scripts/sync-fa-icons.mjs landing",
    "sync:wallpaper": "node scripts/sync-wallpaper-assets.mjs",
    "sync:wallpaper:main": "node scripts/sync-wallpaper-assets.mjs main",
    "sync:wallpaper:dashboard": "node scripts/sync-wallpaper-assets.mjs dashboard",
    "sync:wallpaper:landing": "node scripts/sync-wallpaper-assets.mjs landing",
    "sync:assets:main": "yarn sync:icons:main && yarn sync:wallpaper:main",
    "sync:assets:dashboard": "yarn sync:icons:dashboard && yarn sync:wallpaper:dashboard",
    "sync:assets:landing": "yarn sync:icons:landing && yarn sync:wallpaper:landing",
    "sync:fa-icons": "yarn sync:icons",
    "sync:fa-icons:main": "yarn sync:icons:main",
    "sync:fa-icons:dashboard": "yarn sync:icons:dashboard",
    "sync:fa-icons:landing": "yarn sync:icons:landing",
    "info:main": "yarn workspace @groupher/frontend-main next info",
    "clean:main": "yarn workspace @groupher/frontend-main exec rimraf .next",
    "info:dashboard": "yarn workspace @groupher/frontend-dashboard next info",
    "clean:dashboard": "yarn workspace @groupher/frontend-dashboard exec rimraf .next",
    "clean:gateway": "yarn workspace @groupher/gateway clean",
    "clean:auth": "yarn workspace @groupher/backend-auth clean",
    "clean:assets-hub": "yarn workspace @groupher/assets-hub clean",
    "clean:press": "yarn workspace @groupher/press clean",
    "clean:landing": "yarn workspace @groupher/frontend-landing exec rimraf .next",
    "clean:inspire-me": "yarn workspace @groupher/inspire-me exec rimraf dist *.tsbuildinfo",
    "predev:main": "yarn clean:main",
    "dev:main": "yarn sync:assets:main && yarn clean:main && yarn workspace @groupher/frontend-main dev",
    "predev:dashboard": "yarn clean:dashboard",
    "dev:dashboard": "yarn sync:assets:dashboard && yarn clean:dashboard && yarn workspace @groupher/frontend-dashboard dev",
    "dev:gateway": "yarn workspace @groupher/gateway dev",
    "dev:auth": "yarn workspace @groupher/backend-auth dev",
    "dev:assets-hub": "yarn workspace @groupher/assets-hub dev:local",
    "dev:content-import": "yarn workspace @groupher/backend-content-import dev",
    "dev:press": "yarn workspace @groupher/press dev",
    "dev:document-converter": "cd backend/document-converter && .venv/bin/python -m uvicorn app:app --reload --port 8000",
    "document-converter:install": "cd backend/document-converter && python3.12 -m venv .venv && .venv/bin/python -m pip install --upgrade pip && .venv/bin/python -m pip install -e '.[test]'",
    "test:document-converter": "cd backend/document-converter && .venv/bin/python -m pytest",
    "auth:env:bootstrap": "node scripts/bootstrap-auth-env.mjs",
    "portless:setup": "portless proxy start && portless trust && yarn portless:sync",
    "portless:sync": "portless alias groupher 3003 --force && portless alias main.groupher 3003 --force && portless alias dashboard.groupher 3003 --force && portless alias landing.groupher 3003 --force && portless alias auth.groupher 3004 --force && portless alias inspire-me.groupher 3010 --force && portless alias api.groupher 4001 --force && portless alias content-import.groupher 8001 --force && portless alias assets-hub.groupher 8002 --force && portless alias assets.groupher 8787 --force && portless alias press.groupher 8003 --force && portless alias converter.groupher 8000 --force",
    "build:prod:main": "yarn sync:assets:main && yarn workspace @groupher/frontend-main build",
    "build:prod:dashboard": "yarn sync:assets:dashboard && yarn workspace @groupher/frontend-dashboard build",
    "serve:prod:main": "yarn workspace @groupher/frontend-main run start",
    "serve:prod:dashboard": "yarn workspace @groupher/frontend-dashboard run start",
    "info:landing": "yarn workspace @groupher/frontend-landing next info",
    "predev:landing": "yarn clean:landing",
    "dev:landing": "yarn sync:assets:landing && yarn clean:landing && yarn workspace @groupher/frontend-landing dev",
    "predev:inspire-me": "yarn clean:inspire-me",
    "dev:inspire-me": "yarn clean:inspire-me && yarn workspace @groupher/inspire-me dev --port 3010",
    "build:prod:landing": "yarn sync:assets:landing && yarn workspace @groupher/frontend-landing build",
    "prebuild:prod:inspire-me": "yarn clean:inspire-me",
    "build:prod:inspire-me": "yarn clean:inspire-me && yarn workspace @groupher/inspire-me build",
    "serve:prod:landing": "yarn workspace @groupher/frontend-landing run serve",
    "prebuild:prod:gateway": "yarn clean:gateway",
    "build:prod:gateway": "yarn workspace @groupher/gateway build",
    "build:prod:auth": "yarn workspace @groupher/backend-auth build",
    "build:prod:assets-hub": "yarn workspace @groupher/assets-hub build",
    "build:prod:content-import": "yarn workspace @groupher/backend-content-import build",
    "build:prod:press": "yarn workspace @groupher/press build",
    "serve:prod:gateway": "yarn workspace @groupher/gateway start",
    "ci": "cross-env NODE_ENV=ci next dev",
    "update.version": "node -p \"'export const APP_VERSION = ' + JSON.stringify(require('./package.json').version)\" > config/version.ts",
    "type-check": "yarn check:theme-first-paint-vars && yarn workspace @groupher/contracts type-check && yarn workspace @groupher/service type-check && yarn workspace @groupher/frontend-core type-check && yarn workspace @groupher/frontend-main type-check && yarn workspace @groupher/frontend-dashboard type-check && yarn workspace @groupher/frontend-landing type-check && yarn workspace @groupher/inspire-me type-check && yarn workspace @groupher/gateway type-check && yarn workspace @groupher/backend-auth type-check && yarn workspace @groupher/assets-hub type-check && yarn workspace @groupher/backend-content-import type-check && yarn workspace @groupher/press type-check && yarn workspace @groupher/local-dev-hub type-check",
    "contract:health": "node contracts/services/health/scripts/assert-health.mjs",
    "build": "yarn workspaces foreach -pt --all --exclude @groupher/root run build",
    "dev": "next dev",
    "start": "next start",
    "build:clean": "run-s dist clean",
    "build.prod": "cross-env NODE_ENV=production next build",
    "build.dev": "cross-env NODE_ENV=dev next build",
    "build.ci.old": "cross-env NODE_ENV=ci next build",
    "build:ci": "yarn workspaces foreach -pt --all --exclude @groupher/root run build",
    "serve": "cross-env NODE_ENV=production next start -p ${SERVE_PORT}",
    "serve.dev": "cross-env NODE_ENV=dev next start -p ${SERVE_PORT}",
    "serve.prod": "cross-env NODe_ENV=production next start -p 3000",
    "dist": "next build && next export -o \"build\"",
    "info": "next info",
    "clean": "rimraf --glob \"*.tsbuildinfo\" \"frontend/**/*.tsbuildinfo\" \"backend/**/*.tsbuildinfo\"",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "yarn workspaces foreach -pt --all --exclude @groupher/root run lint",
    "format": "yarn workspaces foreach -pt --all --exclude @groupher/root run format",
    "format:check": "yarn workspaces foreach -pt --all --exclude @groupher/root run format:check",
    "clean:up": "rm -rf *.tsbuildinfo",
    "test": "vitest --config frontend/core/vitest.config.mts run",
    "test:core": "vitest --config frontend/core/vitest.config.mts run frontend/core",
    "test:main": "vitest --config frontend/core/vitest.config.mts run frontend/core frontend/main",
    "test:dashboard": "vitest --config frontend/core/vitest.config.mts run frontend/core frontend/dashboard",
    "test:landing": "vitest --config frontend/core/vitest.config.mts run frontend/core frontend/landing",
    "mock:server": "yarn workspace @groupher/mock-server dev",
    "test:e2e:main": "cross-env E2E_APP=main playwright test -c frontend/e2e/playwright.config.ts",
    "test:e2e:dashboard": "cross-env E2E_APP=dashboard playwright test -c frontend/e2e/playwright.config.ts",
    "test:e2e:landing": "cross-env E2E_APP=landing playwright test -c frontend/e2e/playwright.config.ts",
    "postinstall": "husky",
    "coveralls": "cat ./coverage/lcov.info | coveralls",
    "doctor": "react-doctor .",
    "doctor:main": "react-doctor frontend/main",
    "doctor:dashboard": "react-doctor frontend/dashboard",
    "doctor:landing": "react-doctor frontend/landing",
    "doctor:core": "react-doctor frontend/core",
    "lint-staged": "lint-staged --relative"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@formkit/auto-animate": "^0.9.0",
    "@fortawesome/fontawesome-svg-core": "^6.2.1",
    "@fortawesome/free-regular-svg-icons": "^6.2.1",
    "@fortawesome/free-solid-svg-icons": "^6.2.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@groupher/rich-editor": "0.0.35",
    "@groupher/tooltip": "4.2.7",
    "@groupher/use-mobile-detect-hook": "^2.0.2",
    "@next/bundle-analyzer": "^16.3.0",
    "@platejs/basic-nodes": "^53.0.0",
    "@platejs/core": "^53.2.4",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.18",
    "@tippyjs/react": "^4.2.6",
    "@urql/core": "^6.0.3",
    "@urql/exchange-retry": "^2.0.0",
    "@urql/next": "^2.0.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "accept-language-parser": "^1.5.0",
    "chalk": "^2.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cnfast": "0.0.8",
    "emoji-picker-react": "^4.19.1",
    "graphql": "^16.13.2",
    "graphql-request": "^7.4.0",
    "markdown-to-jsx": "^9.7.16",
    "mastani-codehighlight": "0.0.7",
    "motion": "^12.43.0",
    "nanoid": "^5.1.9",
    "next": "16.3.0",
    "next-compose-plugins": "^2.2.0",
    "overlayscrollbars": "^2.9.1",
    "overlayscrollbars-react": "^0.5.6",
    "pinyin-pro": "^3.28.1",
    "platejs": "^53.2.4",
    "promise-timeout": "^1.3.0",
    "prop-types": "^15.5.10",
    "qrcode.react": "^4.2.0",
    "ramda": "^0.32.0",
    "react": "^19.2.8",
    "react-arborist": "^3.5.0",
    "react-aria-components": "^1.17.0",
    "react-content-loader": "^6.2.1",
    "react-copy-to-clipboard": "5.1.1",
    "react-device-detect": "^2.2.3",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.1",
    "react-flip-numbers": "^3.0.8",
    "react-highlight-words": "^0.21.0",
    "react-masonry-css": "^1.0.16",
    "react-resizable-panels": "^4.11.2",
    "react-scroll-snap-anime-slider": "^1.5.3",
    "react-select": "^5.10.2",
    "react-swipeable": "^7.0.0",
    "react-textarea-autosize": "^8.3.0",
    "react-tooltip": "^4.2.21",
    "react-trend": "^1.2.4",
    "react-use": "17.6.0",
    "remarkable": "2.0.1",
    "remarkable-emoji": "^0.1.3",
    "remarkable-mentions": "^0.1.0",
    "rimraf": "^6.1.3",
    "sanitize-html": "^2.17.3",
    "sentry-testkit": "^2.1.0",
    "stringz": "^2.0.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-animated": "^2.0.0",
    "tinykeys": "^2.1.0",
    "tsparticles-confetti": "^2.12.0",
    "typewriter-effect": "^2.19.0",
    "urql": "^5.0.3",
    "use-debounce": "^10.1.1",
    "valtio": "2.3.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.6.6",
    "@graphql-tools/mock": "^9.1.7",
    "@graphql-tools/schema": "^10.0.33",
    "@heroicons/react": "^2.2.0",
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/mocha": "^8.2.1",
    "@types/ramda": "^0.31.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/sanitize-html": "^2.16.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.0",
    "baseline-browser-mapping": "^2.9.0",
    "commitizen": "3.1.2",
    "coveralls": "3.0.14",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.0.0",
    "graphql-http": "^1.22.4",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^15.2.0",
    "lucide-static": "^1.28.0",
    "npm-run-all": "^4.1.1",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "portless": "0.15.4",
    "postcss": "^8.5.25",
    "react-doctor": "^0.7.6",
    "react-json-view-lite": "^2.5.0",
    "svgo": "^4.0.1",
    "tsc-files": "^1.1.4",
    "typescript": "7.0.2",
    "vite": "^8.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{json,md}": "oxfmt -c frontend/core/config/oxfmt.json",
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "oxfmt -c frontend/core/config/oxfmt.json",
      "oxlint -c frontend/core/config/oxlint.json --fix --threads=1"
    ],
    "frontend/core/**/*.{ts,tsx}": "tsc-files --noEmit --project frontend/core/tsconfig.app.json frontend/core/global.d.ts",
    "frontend/main/**/*.{ts,tsx}": "tsc-files --noEmit --project frontend/main/tsconfig.json",
    "frontend/dashboard/**/*.{ts,tsx}": "tsc-files --noEmit --project frontend/dashboard/tsconfig.json",
    "frontend/landing/**/*.{ts,tsx}": "tsc-files --noEmit --project frontend/landing/tsconfig.json",
    "backend/inspire-me/**/*.{ts,tsx}": "tsc-files --noEmit --project backend/inspire-me/tsconfig.json",
    "local/dev-hub/**/*.{ts,tsx}": "bash -c 'yarn workspace @groupher/local-dev-hub type-check'",
    "backend/auth/**/*.{ts,tsx}": "tsc-files --noEmit --project backend/auth/tsconfig.json",
    "backend/gateway/**/*.{ts,tsx}": "tsc-files --noEmit --project backend/gateway/tsconfig.json",
    "backend/content-import/**/*.{ts,tsx}": "tsc-files --noEmit --project backend/content-import/tsconfig.json"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "yarn@4.17.1",
  "packageManagerConfig": {
    "hoistingLimits": {
      "**/@radix-ui/**": "workspaces",
      "**/shadcn/**": "workspaces",
      "**/@groupher/editor/**": "workspaces"
    }
  }
}
