{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "edge-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    { "pattern": "groupher.com/*", "zone_id": "bd0b41b1b0c3775bd45228dda8567d93" },
    { "pattern": "www.groupher.com/*", "zone_id": "bd0b41b1b0c3775bd45228dda8567d93" },
  ],
  "services": [
    { "binding": "LANDING", "service": "landing" },
    { "binding": "COMMUNITY", "service": "community" },
    { "binding": "AUTH", "service": "auth" },
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    "API_SITE": "https://api.groupher.com",
    "PRESS_SITE": "https://press.groupher.com",
    "CUSTOM_DOMAIN_COMMUNITIES": "{}",
    "NODE_ENV": "production",
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
