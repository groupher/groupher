{
  "name": "@groupher/edge-router",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "dev:local": "wrangler dev --config wrangler.local.jsonc",
    "test": "pnpm exec vitest --config vitest.config.mts run",
    "type-check": "pnpm --workspace-root exec tsc --noEmit --project infra/edge-router/tsconfig.json",
    "types": "wrangler types --config wrangler.jsonc",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "deploy:dry-run": "wrangler deploy --dry-run --config wrangler.jsonc",
    "lint": "pnpm exec oxlint src --threads=1",
    "format": "pnpm exec oxfmt -c ../../frontend/core/config/oxfmt.json src *.ts *.json *.mts",
    "format:check": "pnpm exec oxfmt -c ../../frontend/core/config/oxfmt.json --check src *.ts *.json *.mts",
    "build": "wrangler deploy --dry-run --config wrangler.jsonc"
  },
  "dependencies": {
    "@groupher/contracts": "workspace:*",
    "@groupher/route-contract": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.118.0"
  }
}
