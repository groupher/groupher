22:15:14.104 [info] execute "INSERT INTO cms.article_stats (\n  thread,\n  article_id,\n  views,\n  views_revision,\n  upvotes_count,\n  comments_count,\n  collects_count,\n  comments_participants_count,\n  interaction_revision,\n  comments_revision,\n  reaction_counts,\n  snapshot_at,\n  inserted_at,\n  updated_at\n)\nSELECT\n  'post',\n  article.id,\n  COALESCE(summary.views, 0),\n  COALESCE(summary.revision, 0),\n  COALESCE(reactions.upvotes_count, 0),\n  COALESCE(article.comments_count, 0),\n  COALESCE(reactions.collects_count, 0),\n  COALESCE(article.comments_participants_count, 0),\n  COALESCE(reactions.interaction_revision, 0),\n  COALESCE(article.comments_revision, 0),\n  COALESCE(emotions.reaction_counts, '[]'::jsonb),\n  CURRENT_TIMESTAMP,\n  CURRENT_TIMESTAMP,\n  CURRENT_TIMESTAMP\nFROM cms.posts article\nLEFT JOIN cms.article_view_summaries summary\n  ON summary.thread = 'post' AND summary.article_id = article.id\nLEFT JOIN cms.post_reaction_infos reactions\n  ON reactions.post_id = article.id\nLEFT JOIN LATERAL (\n  SELECT jsonb_agg(\n    jsonb_build_object('type', emotion, 'count', users_count)\n    ORDER BY users_count DESC, emotion ASC\n  ) AS reaction_counts\n  FROM cms.post_emotion_infos\n  WHERE post_id = article.id AND users_count > 0\n) emotions ON TRUE\n"

22:15:14.106 [info] execute "INSERT INTO cms.article_stats (\n  thread,\n  article_id,\n  views,\n  views_revision,\n  upvotes_count,\n  comments_count,\n  collects_count,\n  comments_participants_count,\n  interaction_revision,\n  comments_revision,\n  reaction_counts,\n  snapshot_at,\n  inserted_at,\n  updated_at\n)\nSELECT\n  'blog',\n  article.id,\n  COALESCE(summary.views, 0),\n  COALESCE(summary.revision, 0),\n  COALESCE(reactions.upvotes_count, 0),\n  COALESCE(article.comments_count, 0),\n  COALESCE(reactions.collects_count, 0),\n  COALESCE(article.comments_participants_count, 0),\n  COALESCE(reactions.interaction_revision, 0),\n  COALESCE(article.comments_revision, 0),\n  COALESCE(emotions.reaction_counts, '[]'::jsonb),\n  CURRENT_TIMESTAMP,\n  CURRENT_TIMESTAMP,\n  CURRENT_TIMESTAMP\nFROM cms.blogs article\nLEFT JOIN cms.article_view_summaries summary\n  ON summary.thread = 'blog' AND summary.article_id = article.id\nLEFT JOIN cms.blog_reaction_infos reactions\n  ON reactions.blog_id = article.id\nLEFT JOIN LATERAL (\n  SELECT jsonb_agg(\n    jsonb_build_object('type', emotion, 'count', users_count)\n    ORDER BY users_count DESC, emotion ASC\n  ) AS reaction_counts\n  FROM cms.blog_emotion_infos\n  WHERE blog_id = article.id AND users_count > 0\n) emotions ON TRUE\n"

22:15:14.107 [info] execute "INSERT INTO cms.article_stats (\n  thread,\n  article_id,\n  views,\n  views_revision,\n  upvotes_count,\n  comments_count,\n  collects_count,\n  comments_participants_count,\n  interaction_revision,\n  comments_revision,\n  reaction_counts,\n  snapshot_at,\n  inserted_at,\n  updated_at\n)\nSELECT\n  'changelog',\n  article.id,\n  COALESCE(summary.views, 0),\n  COALESCE(summary.revision, 0),\n  COALESCE(reactions.upvotes_count, 0),\n  COALESCE(article.comments_count, 0),\n  COALESCE(reactions.collects_count, 0),\n  COALESCE(article.comments_participants_count, 0),\n  COALESCE(reactions.interaction_revision, 0),\n  COALESCE(article.comments_revision, 0),\n  COALESCE(emotions.reaction_counts, '[]'::jsonb),\n  CURRENT_TIMESTAMP,\n  CURRENT_TIMESTAMP,\n  CURRENT_TIMESTAMP\nFROM cms.changelogs article\nLEFT JOIN cms.article_view_summaries summary\n  ON summary.thread = 'changelog' AND summary.article_id = article.id\nLEFT JOIN cms.changelog_reaction_infos reactions\n  ON reactions.changelog_id = article.id\nLEFT JOIN LATERAL (\n  SELECT jsonb_agg(\n    jsonb_build_object('type', emotion, 'count', users_count)\n    ORDER BY users_count DESC, emotion ASC\n  ) AS reaction_counts\n  FROM cms.changelog_emotion_infos\n  WHERE changelog_id = article.id AND users_count > 0\n) emotions ON TRUE\n"

22:15:14.109 [info] execute "INSERT INTO cms.article_stats (\n  thread,\n  article_id,\n  views,\n  views_revision,\n  upvotes_count,\n  comments_count,\n  collects_count,\n  comments_participants_count,\n  interaction_revision,\n  comments_revision,\n  reaction_counts,\n  snapshot_at,\n  inserted_at,\n  updated_at\n)\nSELECT\n  'doc',\n  article.id,\n  COALESCE(summary.views, 0),\n  COALESCE(summary.revision, 0),\n  COALESCE(reactions.upvotes_count, 0),\n  COALESCE(article.comments_count, 0),\n  COALESCE(reactions.collects_count, 0),\n  COALESCE(article.comments_participants_count, 0),\n  COALESCE(reactions.interaction_revision, 0),\n  COALESCE(article.comments_revision, 0),\n  COALESCE(emotions.reaction_counts, '[]'::jsonb),\n  CURRENT_TIMESTAMP,\n  CURRENT_TIMESTAMP,\n  CURRENT_TIMESTAMP\nFROM cms.docs article\nLEFT JOIN cms.article_view_summaries summary\n  ON summary.thread = 'doc' AND summary.article_id = article.id\nLEFT JOIN cms.doc_reaction_infos reactions\n  ON reactions.doc_id = article.id\nLEFT JOIN LATERAL (\n  SELECT jsonb_agg(\n    jsonb_build_object('type', emotion, 'count', users_count)\n    ORDER BY users_count DESC, emotion ASC\n  ) AS reaction_counts\n  FROM cms.doc_emotion_infos\n  WHERE doc_id = article.id AND users_count > 0\n) emotions ON TRUE\n"

