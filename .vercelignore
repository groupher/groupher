# Keep Vercel CLI uploads focused on source files. The repo root is shared by
# several Vercel projects, so local build outputs and backend deps can otherwise
# make manual deployments exceed Vercel's request-size limit.

# Build outputs
.next
.next/
**/.next/
frontend/main/.next
frontend/main/.next/
frontend/dashboard/.next
frontend/dashboard/.next/
frontend/landing/.next
frontend/landing/.next/
build
frontend/**/out/
local/**/dist/
backend/**/dist/
local/**/.data/
**/target/
**/*.app/
local/dev-hub/src-tauri/gen/schemas/
coverage/
tools/reports

# Playwright
.playwright/
.playwright-cli/
.playwright-mcp/
playwright-report/
test-results/

# Dependencies
node_modules
node_modules/
**/node_modules/
frontend/**/node_modules/
backend/**/node_modules/
local/**/node_modules/
packages/**/node_modules/
.yalc/
yalc.lock
bun.lockb
npm-debug.log
yarn-error.log

# Yarn Berry
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Python build and test artifacts
**/__pycache__/
*.egg-info/
.pytest_cache/
.venv/

